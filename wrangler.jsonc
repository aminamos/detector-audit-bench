{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detector-audit-bench",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "detector-audit-bench",
      "database_id": "5a81252c-79b1-4293-a815-c8f7c549518f",
      "migrations_dir": "migrations"
    }
  ]
}
